# Application (local, development, production)
NODE_ENV=development
PORT=9096
# The same secret as the User Service: the apps' tokens are checked here too.
JWT_SECRET=

# Relational Database Credential (local: docker compose up -d; DB_SYNC=true creates the tables)
DB_HOST=localhost
DB_PORT=5433
DB_SCHEMA=jalat_counting
DB_USERNAME=jalat
DB_PASSWORD=jalat
DB_CONNECTION=postgres
DB_LOGGING=false
DB_SYNC=true

# Redis Credential: the apps' sessions (sessions:<token>), the same Redis as the User Service
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_AUTH_PASS=

# MQTT Config: live counts and camera status (/topic/counting/<cameraId>/count|status)
MQTT_HOST=mqtt://localhost
MQTT_PORT=1884
MQTT_USER=jalat
MQTT_PASS=jalat

# Model: YOLO26 exported to ONNX once (see README), and its class labels
MODEL_PATH=models/yolo26n.onnx
MODEL_CLASSES_PATH=models/classes.json
# cpu (default) or cuda (needs the CUDA build of onnxruntime-node)
MODEL_PROVIDER=cpu

# Camera defaults (a camera's own settings win)
DEFAULT_FPS=10
DEFAULT_CONF=0.4

# ffmpeg; unset = the one bundled by ffmpeg-static
FFMPEG_PATH=
