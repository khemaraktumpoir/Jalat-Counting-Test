# Every setting of the counting service, for `yarn dev` and for docker compose (deploy/docker-compose.yml)
# on your PC, a cloud server or a PC on site. Copy to .env and fill it in — never commit .env.
# The values below are for local development; the server notes say what to change (deploy/README.md).

# ---- docker compose: which files and which optional parts ----
# The compose files are in deploy/; run docker compose from here (the repo root).
# Local development: + a local Postgres and MQTT (deploy/docker-compose.local.yml).
#   Windows: ";" between the files; Linux / macOS: ":".
# Servers: COMPOSE_FILE=deploy/docker-compose.yml
COMPOSE_FILE=deploy/docker-compose.yml;deploy/docker-compose.local.yml
# Servers: https (a VPS with a domain: Caddy), cloudflare (a PC on site: Cloudflare Tunnel),
# redis-tunnel (Redis only listens on its server: SSH). Comma-separated; empty = the service only.
COMPOSE_PROFILES=

# ---- Application (local, development, production) ----
NODE_ENV=development
PORT=9096
# The same secret as the User Service: the apps' sign-ins are checked here too.
JWT_SECRET=

# ---- Database (local: the compose Postgres on :5433; servers: the Jalat database) ----
# The counting tables in their own schema; DB_SYNC=true creates them once.
DB_HOST=localhost
DB_PORT=5433
DB_SCHEMA=jalat_counting
DB_USERNAME=jalat
DB_PASSWORD=jalat
DB_CONNECTION=postgres
DB_LOGGING=false
DB_SYNC=true

# ---- Redis: the apps' sessions (sessions:<token>), the same Redis as the User Service ----
# With the redis-tunnel profile leave REDIS_HOST empty.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_AUTH_PASS=

# ---- MQTT: live counts and camera status (/topic/counting/<cameraId>/count|status) ----
# Local broker: mqtt://localhost : 1884 (from the container: mqtt://mosquitto : 1883);
# the apps' broker: e.g. wss://mqtt-dev.jalatlogistics.com/mqtt : 443
MQTT_HOST=mqtt://localhost
MQTT_PORT=1884
MQTT_USER=jalat
MQTT_PASS=jalat

# ---- Model ----
# The folder mounted read-only into the container (relative to deploy/; a server: e.g. /srv/counting/models)
MODELS_DIR=../models
# models/yolo26n.onnx, models/parcel.onnx, demo:orange (no model), or ultralytics:<endpoint url>
MODEL_PATH=models/yolo26n.onnx
MODEL_CLASSES_PATH=models/classes.json
# cpu (default) or cuda (needs the CUDA build of onnxruntime-node)
MODEL_PROVIDER=cpu
# CPU threads per camera's model: 0 = all cores; a small server: cores ÷ cameras (1 vCPU: 1)
MODEL_THREADS=0
# MODEL_PATH=ultralytics:<url> only: the Ultralytics Platform API key
ULTRALYTICS_API_KEY=

# ---- Camera defaults (a camera's own settings win; on 1 vCPU keep 3–5 frames a second) ----
DEFAULT_FPS=10
DEFAULT_CONF=0.4
# ffmpeg; unset = the one bundled by ffmpeg-static
FFMPEG_PATH=

# ---- Counting photos (Count photos in the warehouse app; see README "Counting parcels in photos") ----
# The parcel model (make export-photo); unset = models/parcel-world-m.onnx (else -l), else the cameras' model
PHOTO_MODEL_PATH=
# Its input size (the export's imgsz) and default confidence
PHOTO_MODEL_SIZE=1280
PHOTO_CONF=0.06
# Folders a folder count may read (relative to the service folder, or absolute)
PHOTO_ROOTS=photos,samples
# Days back a counted photo is compared with earlier ones for copies (0 = this batch only)
PHOTO_DUP_DAYS=7

# ---- Servers: resources and how the service is reached ----
# Memory / CPU limit (2 GB VPS: 1500m; 4 GB: 3g. CPUs: 0 = no limit, or e.g. 1.0)
COUNTING_MEM_LIMIT=1500m
COUNTING_CPUS=0
# 127.0.0.1 = this machine only (Caddy / the tunnel reach it); 0.0.0.0 = open (firewall it)
COUNTING_BIND=127.0.0.1
# A ready image instead of building here (a 2 GB server builds slowly), e.g.
#   swr.ap-southeast-3.myhuaweicloud.com/<org>/jalat-counting-service:latest
# then: docker compose pull && docker compose up -d --no-build
COUNTING_IMAGE=
# https: the domain (its DNS A record → this server)
DOMAIN=
# cloudflare: Zero Trust → Tunnels → token; public hostname → http://counting:9096
TUNNEL_TOKEN=
# redis-tunnel: user@host, its SSH port, the private key file (relative to deploy/; never commit it)
SSH_TARGET=
SSH_PORT=22
SSH_KEY_FILE=./ssh_key
