{
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "./src",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noUnusedLocals": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "outDir": "dist",
    "sourceMap": true,
    "target": "es6",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": ["dom", "es7"],
    "declaration": false,
    "removeComments": true,
    "noLib": false,
    "skipLibCheck": true,
    "paths": {
      "@api/*": ["src/api/*"],
      "@common": ["src/common"],
      "@entities": ["src/entities"],
      "@graphql/*": ["src/graphql/*"],
      "@lib/*": ["src/lib/*"],
      "@repositories": ["src/repositories"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
